# Kopiera till .env (lokalt) eller .env.production (VPS) och fyll i.

# Postgres
DATABASE_URL=postgres://hemmafix:hemmafix@localhost:5432/hemmafix

# Better Auth – generera med: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Publik bas-URL. Lokalt: http://localhost:3000, prod: https://hemmafix.rmstdope.eu
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
# Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Kommaseparerad lista med e-postadresser som får logga in (steg 1: en familj).
ALLOWED_EMAILS=
# Namnet på hushållet som skapas automatiskt vid första inloggningen.
HOUSEHOLD_NAME=Familjen
