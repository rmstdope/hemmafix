{
  "name": "hemmafix",
  "domain": "hemmafix.rmstdope.eu",
  "profile": "fullstack",
  "stateful": true,
  "migration_policy": "backward-compatible",
  "pre_release_backup": {
    "service": "db",
    "command": ["sh", "-c", "exec timeout 290 pg_dump -U \"$POSTGRES_USER\" --format=custom \"$POSTGRES_DB\""],
    "timeout_seconds": 300
  },
  "deployment": {
    "repository": "rmstdope/hemmafix",
    "workflow": "ci.yml",
    "branch": "main"
  },
  "services": {
    "web": {
      "repository": "ghcr.io/rmstdope/hemmafix",
      "port": 8080,
      "health_path": "/healthz"
    }
  }
}
